{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipproof.dev/schemas/v0.1/verification-plan.schema.json",
  "title": "ShipProof verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "requirements", "invariants"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "change_id": {"type": "string", "minLength": 1},
    "requirements": {"$ref": "#/$defs/items"},
    "invariants": {"$ref": "#/$defs/items"}
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "command": {"type": "string"},
        "human": {"type": "boolean"},
        "rationale": {"type": "string"},
        "accepted_at": {"type": "string", "format": "date-time"}
      },
      "oneOf": [
        {"required": ["command"], "properties": {"command": {"pattern": "\\S"}}},
        {"required": ["human", "rationale"], "properties": {"human": {"const": true}, "rationale": {"pattern": "\\S"}}}
      ],
      "not": {"required": ["command", "accepted_at"]}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proof"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string"},
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/proof"}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  }
}
