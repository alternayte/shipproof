{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipproof.dev/schemas/v0.2/evidence.schema.json",
  "title": "ShipProof evidence pack",
  "description": "The single published artifact. Section 7 of the design document names every top-level field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "verdict",
    "intent",
    "implementation",
    "requirements",
    "checks",
    "unexplained_change",
    "agent",
    "attestation",
    "empty_sections",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "change_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason", "next"],
      "properties": {
        "verdict": { "enum": ["PROVEN", "NOT PROVEN", "FAILED"] },
        "reason": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_hash", "stale"],
      "properties": {
        "source_path": { "type": "string" },
        "snapshot_hash": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string" },
        "stale": { "type": "boolean" },
        "current_source_hash": { "type": "string" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "changed_files", "additions", "deletions", "diff_stat"],
      "properties": {
        "commits": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hash", "author", "timestamp", "subject"],
            "properties": {
              "hash": { "type": "string" },
              "author": { "type": "string" },
              "timestamp": { "type": "string" },
              "subject": { "type": "string" }
            }
          }
        },
        "changed_files": { "type": ["array", "null"], "items": { "type": "string" } },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "diff_stat": { "type": "string" }
      }
    },
    "requirements": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "grade"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string" },
          "proof_refs": { "type": ["array", "null"], "items": { "type": "string" } },
          "state": { "type": "string", "minLength": 1 },
          "grade": { "enum": ["observed", "stated", "claimed"] },
          "detail": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "source", "provenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "skip", "unknown"] },
          "source": { "type": "string" },
          "provenance": { "enum": ["observed", "derived", "inferred", "human"] },
          "detail": { "type": "string" }
        }
      }
    },
    "unexplained_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "coverage_available", "line_findings", "file_findings", "uninstrumented_lines"],
      "properties": {
        "measured": { "type": "boolean" },
        "coverage_available": { "type": "boolean" },
        "line_findings": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "start_line", "end_line"],
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "start_line": { "type": "integer", "minimum": 0 },
              "end_line": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "file_findings": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "ignore_pattern": { "type": "string" }
            }
          }
        },
        "uninstrumented_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "agent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "agent_version": { "type": "string" },
        "model": { "type": "string" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "session_id": { "type": "string" },
        "cost": { "type": "number", "minimum": 0 },
        "tokens": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          }
        },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "exit_status": { "type": "string" },
        "raw_log_ref": { "type": "string" }
      }
    },
    "attestation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["format", "signature"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "payload_type": { "type": "string" },
        "signature": { "type": "string" },
        "subject": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "empty_sections": {
      "type": "object",
      "description": "Rule 2 of Section 7. It maps the name of an empty section onto the reason."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "shipproof_version"],
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "shipproof_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
