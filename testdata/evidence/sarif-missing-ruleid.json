              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "C001",
          "level": "error",
          "message": {
            "text": "Known rule violation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app.go"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
