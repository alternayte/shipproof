#!/usr/bin/env bash
# ShipProof pre-commit hook. It blocks a commit when a proof ran and failed.
#
# Install it:
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# The hook is optional. The command is the contract.
set -euo pipefail

if ! command -v shipproof >/dev/null 2>&1; then
  echo "shipproof is not on the PATH; skipping the evidence check." >&2
  exit 0
fi

# `prove` exits 0 when it ran and recorded, whatever each proof reported. The
# verdict carries the outcome, so read the verdict.
shipproof prove

if shipproof status --json | grep -q '"verdict": "FAILED"'; then
  echo >&2
  shipproof status >&2
  echo >&2
  echo "A proof ran and failed. Fix it, or commit with --no-verify." >&2
  exit 1
fi
